/**
 * CM Cooking — Cloudflare Worker (API เดียว) · Phase 2
 * รับ POST JSON { action, token, ...ข้อมูล } ตอบ JSON { ok, ... } หรือ { ok:false, error }
 * ผูกกับ D1: env.DB (cm-cooking-db) · ตัวแปร env.ALLOWED_ORIGIN (origin ของ GitHub Pages)
 */
import {
  AppError, login, logout, authenticate, changeOwnPassword, throttle,
} from './auth.js';
import { list, get, save, remove } from './customers.js';
import { painpoints, ppList, ppSave, ppActive, ppMove, ppRename } from './painpoints.js';
import { userList, userAdd, userEdit, userActive, stats } from './users.js';
import { audit } from './audit.js';
import { bkkToday } from './validate.js';

const BODY_MAX = 20000;                       // ขนาดคำขอสูงสุด (ตัวอักษร)
/* โควตาต่อผู้ใช้: [ต่อ 2 นาที, ต่อวัน (0 = ไม่จำกัด)] */
const LIMITS = {
  list: [120, 0], find: [30, 600], cfg: [30, 0], get: [40, 400],
  save: [20, 300], remove: [20, 100], admin: [30, 0],
};
const MIN_MS = 120000;

const json = (obj, status, headers) => new Response(JSON.stringify(obj), {
  status,
  headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store',
    'x-content-type-options': 'nosniff', ...headers },
});

/** ทำให้ origin เทียบกันได้: ตัดช่องว่าง ตัด / ท้าย และเป็นตัวพิมพ์เล็ก */
const normOrigin = (s) => String(s || '').trim().replace(/\/+$/, '').toLowerCase();

function corsHeaders(origin, env) {
  if (!origin) return {};
  if (normOrigin(origin) !== normOrigin(env.ALLOWED_ORIGIN)) return null;   // ไม่ใช่โดเมนที่อนุญาต
  return {
    'access-control-allow-origin': origin,
    'access-control-allow-methods': 'POST, OPTIONS',
    'access-control-allow-headers': 'content-type',
    'vary': 'Origin',
  };
}

async function throttleUser(db, me, kind) {
  const [perMin, perDay] = LIMITS[kind];
  const nm = me.name.toLowerCase();
  await throttle(db, `r:${kind}:${nm}:${Math.floor(Date.now() / MIN_MS)}`, MIN_MS, perMin);
  if (perDay) {
    await throttle(db, `d:${kind}:${nm}:${bkkToday()}`, 26 * 3600 * 1000, perDay,
      'ครบโควตาวันนี้แล้ว ติดต่อผู้ดูแลระบบ');
  }
}

/** ล้างแถวหมดอายุเป็นครั้งคราว (ประมาณ 1 ใน 50 คำขอ) */
async function maybeCleanup(db) {
  if (Math.random() > 0.02) return;
  const now = Date.now();
  await db.prepare('DELETE FROM sessions WHERE expires_at < ?1').bind(now).run();
  await db.prepare('DELETE FROM rate_limits WHERE reset_at < ?1').bind(now).run();
}

async function route(db, b, ip) {
  const action = b.action;
  if (action === 'ping') return { ok: true };

  if (action === 'login') {
    await throttle(db, 'ip:' + ip, MIN_MS, 30, 'ส่งคำขอเข้าสู่ระบบถี่เกินไป รอสักครู่');
    const r = await login(db, b.user, b.password);
    await audit(db, r.user.name, 'LOGIN', '');
    return { ok: true, token: r.token, user: { name: r.user.name, role: r.user.role, mustChange: r.user.mustChange },
      rows: await list(db, { day: bkkToday() }) };
  }
  if (action === 'logout') { await logout(db, b.token); return { ok: true }; }

  const me = await authenticate(db, b.token);
  if (me.mustChange && !['change_password', 'logout', 'ping'].includes(action))
    throw new AppError('ต้องตั้งรหัสผ่านใหม่ก่อนใช้งาน', 'MUST_CHANGE', 403);

  switch (action) {
    case 'change_password': {
      await throttleUser(db, me, 'admin');
      await changeOwnPassword(db, me, b.oldPassword, b.newPassword, b.token);
      return { ok: true, user: { name: me.name, role: me.role, mustChange: false } };
    }
    case 'list': {
      await throttleUser(db, me, 'list');
      const q = String(b.q || '').trim();
      if (q) await throttleUser(db, me, 'find');
      return { ok: true, rows: await list(db, { q, all: b.all === true, day: b.day }) };
    }
    case 'painpoints': await throttleUser(db, me, 'cfg'); return painpoints(db);
    case 'pp_list': await throttleUser(db, me, 'admin'); return ppList(db, me);
    case 'pp_save': await throttleUser(db, me, 'admin'); return ppSave(db, b, me);
    case 'pp_active': await throttleUser(db, me, 'admin'); return ppActive(db, b, me);
    case 'pp_move': await throttleUser(db, me, 'admin'); return ppMove(db, b, me);
    case 'pp_rename': await throttleUser(db, me, 'admin'); return ppRename(db, b, me);
    case 'stats': await throttleUser(db, me, 'admin'); return stats(db, b, me);
    case 'get': await throttleUser(db, me, 'get'); return { ok: true, rec: await get(db, b.id) };
    case 'save': await throttleUser(db, me, 'save'); return { ok: true, item: await save(db, b.rec || {}, me) };
    case 'remove': await throttleUser(db, me, 'remove'); return remove(db, b.id, me);
    case 'users': await throttleUser(db, me, 'admin'); return userList(db, me);
    case 'user_add': await throttleUser(db, me, 'admin'); return userAdd(db, b, me);
    case 'user_edit': await throttleUser(db, me, 'admin'); return userEdit(db, b, me);
    case 'user_active': await throttleUser(db, me, 'admin'); return userActive(db, b, me);
    default: throw new AppError('คำสั่งไม่ถูกต้อง', 'BAD_ACTION');
  }
}

export default {
  async fetch(request, env) {
    const origin = request.headers.get('origin');
    const cors = corsHeaders(origin, env);
    if (cors === null) return json({ ok: false, error: 'ไม่อนุญาตให้เรียกจากโดเมนนี้' }, 403);

    if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors });
    if (request.method !== 'POST') return json({ ok: false, error: 'method not allowed' }, 405, cors);

    try {
      const raw = await request.text();
      if (raw.length > BODY_MAX) throw new AppError('ข้อมูลใหญ่เกินไป', 'BIG');
      let b;
      try { b = JSON.parse(raw); } catch { throw new AppError('รูปแบบคำขอไม่ถูกต้อง', 'BAD_JSON'); }
      if (!b || typeof b !== 'object') throw new AppError('รูปแบบคำขอไม่ถูกต้อง', 'BAD_JSON');

      const ip = request.headers.get('cf-connecting-ip') || 'unknown';
      await maybeCleanup(env.DB);
      const r = await route(env.DB, b, ip);
      return json(r, 200, cors);
    } catch (err) {
      if (err instanceof AppError) {
        return json({ ok: false, error: err.message, auth: err.code === 'AUTH' || undefined }, err.status || 400, cors);
      }
      console.error(err);
      return json({ ok: false, error: 'เกิดข้อผิดพลาด ลองใหม่อีกครั้ง' }, 500, cors);
    }
  },
};
